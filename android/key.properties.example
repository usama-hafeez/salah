# Copy this file to `key.properties` (same folder) and fill in your real values.
# `key.properties` is git-ignored and must NEVER be committed.
#
# Generate a keystore first:
#   keytool -genkey -v -keystore upload-keystore.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias upload
#
# storeFile can be an absolute path or a path relative to the android/app folder.
storeFile=upload-keystore.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
